{
  "theme": "ocean",
  "themeMode": "auto",
  "display": {
    "showTokenBar": true,
    "showDiffStats": true,
    "showAgentStatus": true,
    "showCost": true,
    "showDuration": true,
    "showCurrentDir": true,
    "showGitBranch": true,
    "showVersion": false,
    "showPermissionMode": true,
    "useNerdFonts": false,
    "unicode": "auto",
    "maxLines": 3,
    "progressBarWidth": 10,
    "showCacheHitRate": true,
    "showToolActivity": true,
    "toolActivityTailBytes": 16384
  },
  "thresholds": {
    "warning": 0.7,
    "critical": 0.9
  },
  "cacheHitThresholds": {
    "excellent": 80,
    "partial": 50
  },
  "defaultEffortLevel": "medium",
  "language": "en"
}
